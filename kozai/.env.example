# .env.example を .env にコピーして値を入れる。.env は git に入れない（.gitignore 済み）
# 画面（GitHub Pages・npm run dev）はこのファイルを読まない。画面のキーは右上の設定から登録する。
# このファイルは寸法精度の評価スクリプト（npm run eval）だけが使う。

# 使う AI：claude / gemini / openai
AI_PROVIDER=claude
# モデル（空なら既定：claude-opus-5-5 / gemini-4-hydrogen / gpt-6-astra）
AI_MODEL=

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# OpenAI の接続先（Node.js からは直接呼べるので通常は空）
OPENAI_BASE_URL=
